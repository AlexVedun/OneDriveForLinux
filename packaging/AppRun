#!/bin/sh
set -eu

appdir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
bundled_lib_paths=
for directory in "$appdir/usr/lib" "$appdir/usr/lib64" "$appdir/usr/lib/x86_64-linux-gnu"; do
    if [ -d "$directory" ]; then
        bundled_lib_paths="${bundled_lib_paths:+$bundled_lib_paths:}$directory"
    fi
done
if [ -n "$bundled_lib_paths" ]; then
    export LD_LIBRARY_PATH="$bundled_lib_paths${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
daemon_pid=
desktop_pid=

stop_children() {
    if [ -n "$desktop_pid" ]; then
        kill "$desktop_pid" 2>/dev/null || true
        wait "$desktop_pid" 2>/dev/null || true
    fi
    if [ -n "$daemon_pid" ]; then
        kill "$daemon_pid" 2>/dev/null || true
        wait "$daemon_pid" 2>/dev/null || true
    fi
}
trap stop_children EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

"$appdir/usr/bin/onedrive-daemon" &
daemon_pid=$!
"$appdir/usr/bin/onedrive-desktop" "$@" &
desktop_pid=$!
wait "$desktop_pid"
